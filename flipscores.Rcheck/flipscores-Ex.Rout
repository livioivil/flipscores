> cleanEx()
> nameEx("custom_contrasts")
> ### * custom_contrasts
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: custom_contrasts
> ### Title: Build custom contrasts for flip-score tests
> ### Aliases: custom_contrasts apply_custom_contrasts
> 
> ### ** Examples
> 
> set.seed(1)
> dat <- data.frame(
+   treatment = factor(rep(c("Control", "Drug"), each = 30)),
+   sex = factor(rep(c("F", "M"), times = 30)),
+   age_group = factor(rep(c("Young", "Old", "Middle"), length.out = 60)),
+   severity = runif(60, 0, 1)
+ )
> eta <- with(dat,
+   -1 + 0.8 * (treatment == "Drug") + 0.4 * (sex == "M") +
+     0.6 * (age_group == "Old") - 0.3 * severity
+ )
> dat$y <- rbinom(nrow(dat), 1, plogis(eta))
> 
> fit <- glm(y ~ treatment * sex + age_group + severity,
+            data = dat, family = binomial)
> 
> # Simple treatment contrast for one factor
> custom_contrasts(fit, ~ treatment)
Custom contrasts
Formula: ~treatment
Type: simple
Variables: treatment
Level combinations: 2
Contrasts: 1

               Control Drug
Drug - Control      -1    1
> 
> # Pairwise treatment contrasts inside each sex
> custom_contrasts(fit, pairwise ~ treatment | sex)
Custom contrasts
Formula: pairwise ~ treatment | sex
Type: pairwise
Variables: treatment, sex
Level combinations: 4
Contrasts: 2

                   Control:F Drug:F Control:M Drug:M
Control - Drug | F         1     -1         0      0
Control - Drug | M         0      0         1     -1
> 
> # Interaction-cell contrasts, similar to emmeans pairwise comparisons
> cc <- custom_contrasts(fit, pairwise ~ treatment:age_group | sex)
> apply_custom_contrasts(cc)
Custom contrast matrix
Dimensions: 30 contrasts x 12 cells

                                   Control:Middle:F Drug:Middle:F Control:Old:F
Control:Middle - Drug:Middle | F                  1            -1             0
Control:Middle - Control:Old | F                  1             0            -1
Control:Middle - Drug:Old | F                     1             0             0
Control:Middle - Control:Young | F                1             0             0
Control:Middle - Drug:Young | F                   1             0             0
                                   Drug:Old:F Control:Young:F Drug:Young:F
Control:Middle - Drug:Middle | F            0               0            0
Control:Middle - Control:Old | F            0               0            0
Control:Middle - Drug:Old | F              -1               0            0
Control:Middle - Control:Young | F          0              -1            0
Control:Middle - Drug:Young | F             0               0           -1
                                   Control:Middle:M Drug:Middle:M Control:Old:M
Control:Middle - Drug:Middle | F                  0             0             0
Control:Middle - Control:Old | F                  0             0             0
Control:Middle - Drug:Old | F                     0             0             0
Control:Middle - Control:Young | F                0             0             0
Control:Middle - Drug:Young | F                   0             0             0
                                   Drug:Old:M Control:Young:M Drug:Young:M
Control:Middle - Drug:Middle | F            0               0            0
Control:Middle - Control:Old | F            0               0            0
Control:Middle - Drug:Old | F               0               0            0
Control:Middle - Control:Young | F          0               0            0
Control:Middle - Drug:Young | F             0               0            0
