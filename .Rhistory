confint(mod0)
xx <- rnorm(20)
zz <- rnorm(20, 0.2 * xx)
yy <- rnorm(20, 1 + 2 * xx - zz)
flps <- make_flips(20, 5000)
mod1 <- flipscores(yy ~ xx + zz)
summary(mod1)
confint(mod1, flips = flps)
